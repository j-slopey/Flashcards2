{"category": "Directions & Places", "italian": "Scusi, dov'è la stazione?", "english": "Excuse me, where is the station?", "spanish": "Disculpe, ¿dónde está la estación?"}
{"category": "Directions & Places", "italian": "È lontano da qui?", "english": "Is it far from here?", "spanish": "¿Está lejos de aquí?"}
{"category": "Directions & Places", "italian": "È qui vicino.", "english": "It's near here.", "spanish": "Está aquí cerca."}
{"category": "Directions & Places", "italian": "Giri a destra.", "english": "Turn right.", "spanish": "Gire a la derecha."}
{"category": "Directions & Places", "italian": "Giri a sinistra.", "english": "Turn left.", "spanish": "Gire a la izquierda."}
{"category": "Directions & Places", "italian": "Vada sempre dritto.", "english": "Go straight ahead.", "spanish": "Vaya todo recto."}
{"category": "Directions & Places", "italian": "C'è una fermata dell'autobus qui vicino?", "english": "Is there a bus stop nearby?", "spanish": "¿Hay una parada de autobús cerca?"}
{"category": "Directions & Places", "italian": "Deve attraversare la piazza.", "english": "You have to cross the square.", "spanish": "Tiene que cruzar la plaza."}
{"category": "Directions & Places", "italian": "È in fondo alla strada.", "english": "It's at the end of the street.", "spanish": "Está al fondo de la calle."}
{"category": "Directions & Places", "italian": "Può dirmelo sulla mappa?", "english": "Can you show me on the map?", "spanish": "¿Puede señalármelo en el mapa?"}
{"category": "Directions & Places", "italian": "Come arrivo al centro?", "english": "How do I get to the center?", "spanish": "¿Cómo llego al centro?"}
{"category": "Directions & Places", "italian": "È sulla destra.", "english": "It's on the right.", "spanish": "Está a la derecha."}
{"category": "Directions & Places", "italian": "È sulla sinistra.", "english": "It's on the left.", "spanish": "Está a la izquierda."}
{"category": "Directions & Places", "italian": "È proprio dietro l'angolo.", "english": "It's just around the corner.", "spanish": "Está justo a la vuelta de la esquina."}
{"category": "Directions & Places", "italian": "Dov'è il bagno?", "english": "Where is the bathroom?", "spanish": "¿Dónde está el baño?"}
{"category": "Directions & Places", "italian": "Mi sono perso.", "english": "I am lost.", "spanish": "Estoy perdido."}
{"category": "Directions & Places", "italian": "È raggiungibile a piedi?", "english": "Is it walkable?", "spanish": "¿Se puede ir andando?"}
{"category": "Directions & Places", "italian": "Prenda la prima traversa a destra.", "english": "Take the first street on the right.", "spanish": "Coja la primera calle a la derecha."}
{"category": "Directions & Places", "italian": "È di fronte alla chiesa.", "english": "It's opposite the church.", "spanish": "Está frente a la iglesia."}
{"category": "Directions & Places", "italian": "Quanto tempo ci vuole?", "english": "How long does it take?", "spanish": "¿Cuánto tiempo se tarda?"}
{"category": "Socializing & Study Abroad", "italian": "Come ti chiami?", "english": "What is your name?", "spanish": "¿Cómo te llamas?"}
{"category": "Socializing & Study Abroad", "italian": "Di dove sei?", "english": "Where are you from?", "spanish": "¿De dónde eres?"}
{"category": "Socializing & Study Abroad", "italian": "Cosa studi?", "english": "What are you studying?", "spanish": "¿Qué estudias?"}
{"category": "Socializing & Study Abroad", "italian": "Che ne dici di prendere un caffè?", "english": "How about getting a coffee?", "spanish": "¿Qué te parece si tomamos un café?"}
{"category": "Socializing & Study Abroad", "italian": "Ti va di uscire stasera?", "english": "Do you feel like going out tonight?", "spanish": "¿Te apetece salir esta noche?"}
{"category": "Socializing & Study Abroad", "italian": "Hai Instagram?", "english": "Do you have Instagram?", "spanish": "¿Tienes Instagram?"}
{"category": "Socializing & Study Abroad", "italian": "Ci scambiamo il numero?", "english": "Shall we exchange numbers?", "spanish": "¿Intercambiamos números?"}
{"category": "Socializing & Study Abroad", "italian": "Dove si trova l'aula?", "english": "Where is the classroom?", "spanish": "¿Dónde está el aula?"}
{"category": "Socializing & Study Abroad", "italian": "Hai preso appunti?", "english": "Did you take notes?", "spanish": "¿Tomaste apuntes?"}
{"category": "Socializing & Study Abroad", "italian": "Ci vediamo dopo lezione?", "english": "See you after class?", "spanish": "¿Nos vemos después de clase?"}
{"category": "Socializing & Study Abroad", "italian": "A che ora inizia la lezione?", "english": "What time does class start?", "spanish": "¿A qué hora empieza la clase?"}
{"category": "Socializing & Study Abroad", "italian": "Ti va di studiare insieme?", "english": "Would you like to study together?", "spanish": "¿Te apetece estudiar juntos?"}
{"category": "Socializing & Study Abroad", "italian": "Che programmi hai per il weekend?", "english": "What are your plans for the weekend?", "spanish": "¿Qué planes tienes para el fin de semana?"}
{"category": "Socializing & Study Abroad", "italian": "Ci sentiamo su WhatsApp?", "english": "Shall we talk on WhatsApp?", "spanish": "¿Hablamos por WhatsApp?"}
{"category": "Socializing & Study Abroad", "italian": "È la mia prima volta qui.", "english": "It's my first time here.", "spanish": "Es mi primera vez aquí."}
{"category": "Socializing & Study Abroad", "italian": "Mi fai vedere il campus?", "english": "Can you show me around the campus?", "spanish": "¿Me enseñas el campus?"}
{"category": "Socializing & Study Abroad", "italian": "Dove mangiamo oggi?", "english": "Where are we eating today?", "spanish": "¿Dónde comemos hoy?"}
{"category": "Socializing & Study Abroad", "italian": "Hai capito cosa ha detto il professore?", "english": "Did you understand what the professor said?", "spanish": "¿Entendiste lo que dijo el profesor?"}
{"category": "Socializing & Study Abroad", "italian": "Ti va di fare un giro in centro?", "english": "Do you want to take a walk downtown?", "spanish": "¿Te apetece dar una vuelta por el centro?"}
{"category": "Socializing & Study Abroad", "italian": "Ci vediamo lì?", "english": "Shall we meet there?", "spanish": "¿Nos vemos allí?"}
